# Скопируй в .env.local и заполни.
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key или sb_publishable_...>
# URL Edge Functions: https://<project-ref>.supabase.co/functions/v1
NEXT_PUBLIC_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1

# Только для разработки в обычном браузере (вне Telegram).
# Требует ALLOW_DEV_AUTH=true в секретах Supabase. В проде НЕ задавай.
# NEXT_PUBLIC_DEV_TG_ID=123456789
